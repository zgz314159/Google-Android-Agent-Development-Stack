{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://android-agent-stack/specification/contracts/package-manifest.schema.json",
  "title": "Spec Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["package", "generated_by", "algorithm", "entries"],
  "properties": {
    "package": { "type": "string", "minLength": 1 },
    "generated_by": { "type": "string", "minLength": 1 },
    "algorithm": { "type": "string", "const": "sha256" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size", "role", "required", "source"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": { "type": "integer", "minimum": 0 },
          "role": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
