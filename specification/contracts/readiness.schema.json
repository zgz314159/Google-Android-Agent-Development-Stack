{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://android-agent-stack/specification/contracts/readiness.schema.json",
  "title": "Readiness Gate Result (READY.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "contract_id",
    "experiment_id",
    "status",
    "unresolved_questions",
    "validation"
  ],
  "properties": {
    "contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "contract_id": { "type": "string", "minLength": 1 },
    "experiment_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["READY", "NOT_READY"] },
    "unresolved_questions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "traceability", "boundaries", "acceptance", "hashes"],
      "properties": {
        "schema": { "type": "string", "enum": ["PASS", "FAIL"] },
        "traceability": { "type": "string", "enum": ["PASS", "FAIL"] },
        "boundaries": { "type": "string", "enum": ["PASS", "FAIL"] },
        "acceptance": { "type": "string", "enum": ["PASS", "FAIL"] },
        "hashes": { "type": "string", "enum": ["PASS", "FAIL"] }
      }
    }
  }
}
